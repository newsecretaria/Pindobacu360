# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo usado na curadoria (padrao: claude-sonnet-5)
# MODELO_CURADORIA=claude-sonnet-5

# Opcional: porta do painel (padrao: 3000)
# PORTA=3000

# Opcional: desliga a coleta automatica a cada 15 min (o painel continua funcionando)
# COLETA_AUTOMATICA=false
